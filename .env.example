# Demo uses deterministic synthetic data by default.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=

# Reown/WalletConnect Cloud project ID (allowlist this app origin).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Circle native USDC on Ethereum Sepolia (chain ID 11155111, 6 decimals).
NEXT_PUBLIC_SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
SEPOLIA_USDC_DECIMALS=6

# Server-only MariaDB/MySQL URL for durable PaymentProof storage. Keep credentials out of NEXT_PUBLIC_* variables.
DATABASE_URL=

# Set to a verified, public recipient address that the Trust Engine should allow.
NEXT_PUBLIC_SEPOLIA_PAYMENT_RECIPIENT_ADDRESS=

# Optional public HTTPS Sepolia RPC used only if the wallet must add the network.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
